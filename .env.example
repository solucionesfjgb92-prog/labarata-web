# ══════════════════════════════════════════════
#  VARIABLES DE ENTORNO — Servidor La Barata
#  IMPORTANTE: NUNCA subas este archivo a GitHub
#  Renombra este archivo a ".env" antes de usar
# ══════════════════════════════════════════════

# ── TOKEN BSALE ────────────────────────────────
# Solicítalo a ayuda@bsale.app con tu RUT de empresa
# Ejemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
BSALE_TOKEN=PEGA_AQUI_TU_TOKEN_DE_BSALE

# ── ID DE TU SUCURSAL (office) ─────────────────
# Encuéntralo en Bsale: Configuración > Sucursales
# O llamando a GET /api/sucursales con el servidor encendido
BSALE_OFFICE_ID=1

# ── ID LISTA DE PRECIOS ────────────────────────
# Encuéntralo en Bsale: Inventario > Listas de precios
# O llamando a GET /api/precios con el servidor encendido
BSALE_PRICE_LIST=1

# ── TIPO DE DOCUMENTO ─────────────────────────
# 8 = Nota de Venta (pre-venta, no emite al SII)
# Consulta tus tipos en Bsale: Configuración > Tipos de documentos
BSALE_DOCUMENT_TYPE=8

# ── URL DE TU PÁGINA WEB ──────────────────────
# Permite que solo tu web pueda llamar al servidor
# y es adonde vuelve el cliente después de pagar.
# En desarrollo usa * (permite todos)
# En producción pon tu dominio: https://www.distribuidoralabarata.cl
FRONTEND_URL=*

# ── PASARELA DE PAGO ACTIVA ───────────────────
# webpay = Transbank Webpay Plus (actual) · flow = Flow.cl (se conserva)
PASARELA=webpay

# ── TRANSBANK WEBPAY PLUS ─────────────────────
# integration usa las credenciales públicas de prueba de Transbank y no
# mueve dinero real. Para cobrar de verdad: TBK_ENV=production y pegar
# las credenciales que entrega Transbank tras certificar la integración.
TBK_ENV=integration
# TBK_COMMERCE_CODE=   (solo en producción)
# TBK_API_KEY_SECRET=  (solo en producción — es una contraseña, nunca en git)

# ── FLOW (PAGOS CON TARJETA) ──────────────────
# Credenciales desde flow.cl > Mis datos > Integraciones.
# OJO: sandbox y producción tienen credenciales DISTINTAS.
FLOW_API_KEY=PEGA_AQUI_TU_API_KEY_DE_FLOW
FLOW_SECRET_KEY=PEGA_AQUI_TU_SECRET_KEY_DE_FLOW

# Ambiente de Flow:
#   Pruebas    -> https://sandbox.flow.cl/api  (por defecto si no se define)
#   Producción -> https://www.flow.cl/api
FLOW_API_URL=https://sandbox.flow.cl/api

# ── DESPACHO POR DISTANCIA ────────────────────
# Tramos "kmMax:precio" separados por coma. El último kmMax es el
# radio máximo de despacho con tarjeta (más lejos → WhatsApp).
DESPACHO_TRAMOS=3:2000,6:3000,10:4500

# Tarifa de respaldo cuando la dirección no se puede geolocalizar (CLP)
DESPACHO_FIJO=3000

# Coordenadas del local (origen del cálculo de distancia)
ORIGEN_LAT=-39.8196
ORIGEN_LON=-73.2452

# ── PUERTO DEL SERVIDOR ────────────────────────
# Render lo asigna automáticamente; en local usa 3000
PORT=3000
